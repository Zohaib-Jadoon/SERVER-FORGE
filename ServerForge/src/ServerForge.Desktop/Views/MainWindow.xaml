<Window x:Class="ServerForge.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ServerForge.Desktop.Views.Pages"
        Title="ServerForge — Native Windows Self-Hosted Deployment Platform"
        Width="1380" Height="880"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Overview" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Projects" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Applications" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="GitHub" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Deployments" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Domains" />
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="EnvVars" />
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Databases" />
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Servers" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Monitoring" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Logs" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Backups" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding NavigateToCommand}" CommandParameter="Settings" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ToggleThemeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Native WPF Navigation Sidebar (All 13 Functional Sections) -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14">
                    <TextBlock Text="ServerForge" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Windows Deployment Control" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,12,12,16">
                    <Button Content="Toggle Theme (Ctrl+T)" Command="{Binding ToggleThemeCommand}" Margin="0,0,0,6" Padding="10,7" />
                    <Button Content="Toggle Isolated Demo Mode" Command="{Binding ToggleDemoModeCommand}" Padding="10,7" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ShortcutHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Primary Workspace Viewport -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Workspace Header -->
            <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SelectedSection.Title}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedSection.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Content="Refresh Live State" Command="{Binding RefreshLiveDataCommand}" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
                </DockPanel>
            </Border>

            <!-- Status & Error Feedback Strip -->
            <StackPanel Grid.Row="1" Margin="24,14,24,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Dynamic Native WPF Page Host (Routes to All 13 Separate Views) -->
            <ScrollViewer Grid.Row="2" Padding="24" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate><pages:OverviewView /></DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Projects">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:ProjectsView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Applications">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:ApplicationsView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="GitHub">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:GitHubView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Deployments">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:DeploymentsView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Domains">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:DomainsSslView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="EnvVars">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:EnvironmentVariablesView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Databases">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:DatabasesView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Servers">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:ServersView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Monitoring">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:MonitoringView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Logs">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:LogsView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Backups">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:BackupsView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Settings">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value><DataTemplate><pages:SettingsView /></DataTemplate></Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
