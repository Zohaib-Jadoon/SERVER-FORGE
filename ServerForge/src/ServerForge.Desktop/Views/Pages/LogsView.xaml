<UserControl x:Class="ServerForge.Desktop.Views.Pages.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                    <Button Content="Sync Agent Logs" Command="{Binding SyncAgentAuditLogsCommand}" Margin="0,0,8,0" Padding="12,6" />
                    <Button Content="Refresh Local" Command="{Binding RefreshLiveDataCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <TextBox Text="{Binding LogFilterQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Filter audit, deployment, and security events (all secrets redacted)" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <DataGrid ItemsSource="{Binding FilteredAuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="340">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc}" Width="160" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180" />
                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="130" />
                    <DataGridTextColumn Header="Target" Binding="{Binding TargetResource}" Width="160" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
