<UserControl x:Class="ServerForge.Desktop.Views.Pages.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Live Windows OS Telemetry (Zero Fabricated Metrics)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="Server Hostname" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LatestTelemetry.Hostname, FallbackValue='Connect a paired server to view live telemetry'}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CPU Utilization" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LatestTelemetry.CpuUsagePercent, StringFormat={}{0:F1}%, FallbackValue='—'}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Used RAM (Bytes)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LatestTelemetry.UsedMemoryBytes, StringFormat={}{0:N0}, FallbackValue='—'}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Fixed Disk Volumes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding LatestTelemetry.Drives}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="80" />
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="Total Bytes" Binding="{Binding TotalBytes}" Width="*" />
                        <DataGridTextColumn Header="Free Bytes" Binding="{Binding FreeBytes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <StackPanel>
                <TextBlock Text="TLS Certificates &amp; Expiration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding LatestTelemetry.Certificates}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="2*" />
                        <DataGridTextColumn Header="Days Remaining" Binding="{Binding DaysRemaining}" Width="120" />
                        <DataGridTextColumn Header="Expires (UTC)" Binding="{Binding NotAfterUtc}" Width="1.5*" />
                        <DataGridTextColumn Header="win-acme" Binding="{Binding ManagedByWinAcme}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
