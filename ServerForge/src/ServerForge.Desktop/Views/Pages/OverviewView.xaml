<UserControl x:Class="ServerForge.Desktop.Views.Pages.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Connected Windows Servers" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ConnectedServerCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainerStyle}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Managed Applications" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalApplicationCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardContainerStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Verified Deployments" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SuccessfulDeploymentCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Connected Server Telemetry Snapshot" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="Host" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LatestTelemetry.Hostname, FallbackValue='No live agent connected'}" FontSize="14" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CPU Utilization (%)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LatestTelemetry.CpuUsagePercent, StringFormat={}{0:F1}%, FallbackValue='—'}" FontSize="14" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Captured (UTC)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LatestTelemetry.CapturedAtUtc, StringFormat={}{0:u}, FallbackValue='—'}" FontSize="14" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <StackPanel>
                <TextBlock Text="Recent Deployments" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding Deployments}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                        <DataGridTextColumn Header="Commit" Binding="{Binding CommitSha}" Width="140" />
                        <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="100" />
                        <DataGridTextColumn Header="Triggered By" Binding="{Binding TriggeredBy}" Width="160" />
                        <DataGridTextColumn Header="Queued (UTC)" Binding="{Binding QueuedAtUtc}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
