<UserControl x:Class="ServerForge.Desktop.Views.Pages.DatabasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Connect Standalone SQL Server or PostgreSQL (Local or External Neon)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="Database services run independently of IIS. Database ports are never exposed publicly by ServerForge." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Display Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding NewDbName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="5,0,5,6">
                        <TextBlock Text="Engine" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableDbEngines}" SelectedItem="{Binding NewDbEngine}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="10,0,0,6">
                        <TextBlock Text="Host / Instance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding NewDbHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                </UniformGrid>
                <DockPanel Margin="0,4,0,8">
                    <Button Content="Save &amp; Test Connection" Command="{Binding SaveAndTestDatabaseCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBox Text="{Binding NewDbConnectionString, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Connection string (stored encrypted via DPAPI)" />
                </DockPanel>
                <CheckBox Content="External Managed Infrastructure (e.g., Neon PostgreSQL — ServerForge connects without claiming ownership)" IsChecked="{Binding NewDbExternalManaged}" />
                <TextBlock Text="{Binding DbTestResultText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <DataGrid ItemsSource="{Binding DatabaseServers}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.6*" />
                    <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="1.4*" />
                    <DataGridTextColumn Header="Host / Instance" Binding="{Binding HostOrInstance}" Width="1.6*" />
                    <DataGridTextColumn Header="External Infra" Binding="{Binding IsExternalManagedInfrastructure}" Width="105" />
                    <DataGridTextColumn Header="Public Port" Binding="{Binding ExposePublicly}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
