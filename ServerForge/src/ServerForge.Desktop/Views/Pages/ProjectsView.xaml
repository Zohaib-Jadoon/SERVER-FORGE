<UserControl x:Class="ServerForge.Desktop.Views.Pages.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Create Multi-Service Project Group" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Project Name (e.g., Commerce Platform)" />
                    <TextBox Grid.Column="2" Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Project Description" />
                    <Button Grid.Column="4" Content="Create Project" Command="{Binding CreateProjectCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <StackPanel>
                <TextBlock Text="Projects" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding Projects}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="*" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                        <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAtUtc}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
