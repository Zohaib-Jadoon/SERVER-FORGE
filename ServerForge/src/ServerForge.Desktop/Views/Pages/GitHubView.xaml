<UserControl x:Class="ServerForge.Desktop.Views.Pages.GitHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <DockPanel>
                <Button Content="Fetch Repositories" Command="{Binding LoadGitHubRepositoriesCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                <TextBox Text="{Binding GitHubSearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Search accessible GitHub repositories" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Accessible GitHub Repositories" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Inspect Commits" Command="{Binding LoadSelectedRepoCommitsCommand}" Margin="0,0,8,0" Padding="10,5" />
                            <Button Content="Import to New App" Command="{Binding ImportSelectedRepositoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Repository" Binding="{Binding FullName}" Width="2*" />
                            <DataGridTextColumn Header="Branch" Binding="{Binding DefaultBranch}" Width="*" />
                            <DataGridTextColumn Header="Private" Binding="{Binding IsPrivate}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardContainerStyle}">
                <StackPanel>
                    <TextBlock Text="Recent Branch Commits" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding RecentCommits}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SHA" Binding="{Binding ShortSha}" Width="80" />
                            <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="110" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
