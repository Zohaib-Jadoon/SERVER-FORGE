<UserControl x:Class="ServerForge.Desktop.Views.Pages.DomainsSslView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Configure Custom Domain &amp; HTTPS Binding" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewDomainHostname, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="e.g., api.yourdomain.com" />
                    <CheckBox Grid.Column="2" Content="Enable HTTPS (443)" IsChecked="{Binding NewDomainHttps}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="4" Content="win-acme Let's Encrypt" IsChecked="{Binding NewDomainWinAcme}" VerticalAlignment="Center" />
                    <Button Grid.Column="6" Content="Save Domain" Command="{Binding AddDomainBindingCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
                <TextBlock Text="{Binding DnsGuidanceOutput}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <DataGrid ItemsSource="{Binding Domains}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="2*" />
                    <DataGridTextColumn Header="HTTPS" Binding="{Binding HttpsEnabled}" Width="80" />
                    <DataGridTextColumn Header="win-acme" Binding="{Binding UseWinAcmeLetsEncrypt}" Width="90" />
                    <DataGridTextColumn Header="DNS Verified" Binding="{Binding DnsVerified}" Width="100" />
                    <DataGridTextColumn Header="Certificate Expiry" Binding="{Binding CertificateExpiresUtc}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
