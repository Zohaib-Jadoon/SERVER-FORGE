<UserControl x:Class="ServerForge.Desktop.Views.Pages.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Pair Remote Windows Server Agent (Mutual TLS over VPN / Private Network)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Display Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PairServerName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="5,0,5,6">
                        <TextBlock Text="VPN / Private IP" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PairServerHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="10,0,0,6">
                        <TextBlock Text="Agent Port" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PairServerPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="One-Time Pairing Code" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PairOneTimeCode, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="5,0,5,6">
                        <TextBlock Text="Agent Cert Thumbprint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PairThumbprint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Margin="10,16,0,6" VerticalAlignment="Bottom">
                        <Button Content="Pair &amp; Save Server" Command="{Binding PairNewServerCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Paired Windows Servers (Persisted in SQLite)" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Inspect IIS &amp; Capabilities" Command="{Binding InspectSelectedServerIisCommand}" Margin="0,0,8,0" Padding="10,6" />
                        <Button Content="Rotate mTLS Cert" Command="{Binding RotateSelectedServerCertificateCommand}" Padding="10,6" />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Server" Binding="{Binding DisplayName}" Width="1.6*" />
                        <DataGridTextColumn Header="Address" Binding="{Binding HostAddress}" Width="1.2*" />
                        <DataGridTextColumn Header="Port" Binding="{Binding AgentPort}" Width="70" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Pinned Cert" Binding="{Binding PinnedServerCertThumbprint}" Width="1.6*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <StackPanel>
                <TextBlock Text="Discovered IIS Websites (Pre-existing Sites Protected Read-Only)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding DiscoveredIisSites}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Site Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                        <DataGridTextColumn Header="AppPool" Binding="{Binding AppPoolName}" Width="1.4*" />
                        <DataGridTextColumn Header="Classic ASP" Binding="{Binding ContainsClassicAspIndicators}" Width="95" />
                        <DataGridTextColumn Header="Protection" Binding="{Binding ManagementState}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
