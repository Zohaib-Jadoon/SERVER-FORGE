<UserControl x:Class="ServerForge.Desktop.Views.Pages.EnvironmentVariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="DPAPI-Encrypted Application Environment Variables" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableEnvTiers}" SelectedItem="{Binding SelectedEnvTier}" Padding="6" />
                    <TextBox Grid.Column="2" Text="{Binding NewEnvKey, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="KEY_NAME" />
                    <TextBox Grid.Column="4" Text="{Binding NewEnvValue, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Value (encrypted with Windows DPAPI when Secret is checked)" />
                    <CheckBox Grid.Column="6" Content="Secret" IsChecked="{Binding NewEnvIsSecret}" VerticalAlignment="Center" />
                    <Button Grid.Column="8" Content="Save Variable" Command="{Binding SaveEnvVarCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <TextBlock Text="Bulk .env Import (Secrets encrypted automatically via Windows DPAPI)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,4" />
                <DockPanel>
                    <Button Content="Import .env" Command="{Binding ImportDotEnvCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,6" />
                    <TextBox Text="{Binding DotEnvImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" Padding="8,6" FontFamily="Consolas" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardContainerStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Saved Environment Variables" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="Delete Selected Variable" Command="{Binding DeleteSelectedEnvVarCommand}" DockPanel.Dock="Right" Padding="10,5" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding EnvironmentVariables}" SelectedItem="{Binding SelectedEnvVar, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="110" />
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*" />
                        <DataGridTextColumn Header="Secret (DPAPI)" Binding="{Binding IsSecret}" Width="110" />
                        <DataGridTextColumn Header="Updated (UTC)" Binding="{Binding UpdatedAtUtc}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
