<Window x:Class="ServerForge.Desktop.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServerForge — First-Launch Setup"
        Icon="pack://application:,,,/Assets/serverforge-icon.png"
        Width="800" Height="620"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource CanvasBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                <Image Source="pack://application:,,,/Assets/serverforge-icon.png"
                       Width="36" Height="36"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ServerForge Setup Wizard" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <ProgressBar Minimum="1" Maximum="10" Value="{Binding CurrentStep}" Height="4" />
        </StackPanel>

        <!-- Step Content -->
        <Border Grid.Row="1" Style="{StaticResource CardContainerStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ServerForge runs 100% locally on your Windows 11 PC using SQLite and Windows DPAPI — no cloud ServerForge account or external metadata database is required."
                               TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" />

                    <StackPanel Margin="0,6">
                        <TextBlock Text="Local Admin Display Name" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />

                        <TextBlock Text="Local Admin Username" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Local Admin Password (min 8 chars)" Margin="0,0,0,4" />
                                <PasswordBox x:Name="AdminPasswordBox" PasswordChanged="OnAdminPasswordChanged" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Confirm Password" Margin="0,0,0,4" />
                                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnConfirmPasswordChanged" Padding="8,6" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="GitHub Fine-Grained PAT (optional — encrypted locally via DPAPI)" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="Validate Token" Command="{Binding ValidateGitHubTokenCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBox Text="{Binding GitHubToken, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                        </DockPanel>
                        <TextBlock Text="{Binding GitHubValidationSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <CheckBox Content="Pair a remote Windows Server Agent during initial setup (uncheck to skip directly to dashboard)"
                                  IsChecked="{Binding AddServerNow}" Margin="0,0,0,10" />

                        <TextBlock Text="Remote Windows Server (Display Name, VPN / Private IP, Port)" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="0.7*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ServerDisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Server Display Name" />
                            <TextBox Grid.Column="2" Text="{Binding ServerHostAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="VPN / Private IP (e.g., 10.10.0.5)" />
                            <TextBox Grid.Column="4" Text="{Binding ServerAgentPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Agent Port (default 9443)" />
                        </Grid>

                        <TextBlock Text="Agent One-Time Pairing Code &amp; Server Cert Thumbprint (from pairing-code.txt)" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AgentPairingCode, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,6" ToolTip="One-time pairing code" />
                        <TextBox Text="{Binding AgentCertThumbprint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Pinned SHA-1 Server Certificate Thumbprint" />

                        <WrapPanel Margin="0,4">
                            <Button Content="Verify DPAPI Store" Command="{Binding VerifyDpapiStoreCommand}" Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="Pair Agent (mTLS)" Command="{Binding PairAgentCommand}" Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="Run Read-Only Diagnostics" Command="{Binding RunReadOnlyDiagnosticsCommand}" Padding="12,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PairingStatus}" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusBanner}" Margin="0,12,0,0" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Controls -->
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Back" Command="{Binding PreviousStepCommand}" DockPanel.Dock="Left" Padding="16,8" />
            <Button Content="{Binding PrimaryActionLabel}" Command="{Binding NextStepCommand}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
